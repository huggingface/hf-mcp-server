{
	"name": "@llmindset/hf-mcp-server",
	"version": "0.4.31",
	"description": "Official Hugging Face MCP Server",
	"type": "module",
	"main": "./dist/server/streamableHttp.js",
	"bin": {
		"hf-mcp-server": "./dist/server/stdio.js",
		"hf-mcp-server-http": "./dist/server/streamableHttp.js",
		"hf-mcp-server-http-json": "./dist/server/streamableHttp.js"
	},
	"files": [
		"dist/**/*",
		"components.json"
	],
	"keywords": [
		"mcp",
		"huggingface",
		"ai",
		"model-context-protocol"
	],
	"author": "Hugging Face",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/evalstate/hf-mcp-server.git",
		"directory": "packages/app"
	},
	"homepage": "https://github.com/evalstate/hf-mcp-server",
	"bugs": {
		"url": "https://github.com/evalstate/hf-mcp-server/issues"
	},
	"scripts": {
		"build": "pnpm run build:web && pnpm run build:singlefiles && pnpm run build:server",
		"build:server": "tsc -p tsconfig.server.json",
		"build:web": "vite build",
		"build:singlefiles": "pnpm run build:mcp-welcome",
		"build:mcp-welcome": "cross-env VITE_BUILD_TARGET=mcp-welcome vite build",
		"dev": "pnpm run build:server && cross-env NODE_ENV=development node dist/server/streamableHttp.js",
		"dev:vite": "vite dev",
		"dev:stdio": "pnpm run build:server && cross-env NODE_ENV=development node dist/server/stdio.js",
		"dev:watch": "concurrently \"tsc -p tsconfig.server.json --watch\" \"vite build --watch\" \"nodemon dist/server/streamableHttp.js\"",
		"start": "cross-env NODE_ENV=production node dist/server/streamableHttp.js",
		"start:stdio": "cross-env NODE_ENV=production node dist/server/stdio.js",
		"test": "vitest run",
		"lint": "eslint . --fix",
		"lint:check": "eslint .",
		"typecheck": "tsc --noEmit",
		"clean": "rimraf dist",
		"preview": "vite preview"
	},
	"dependencies": {
		"@huggingface/hub": "^2.17.6",
		"@llmindset/hf-mcp": "workspace:^",
		"@modelcontextprotocol/client": "2.3.1",
		"@modelcontextprotocol/node": "2.1.1",
		"@modelcontextprotocol/server": "2.3.1",
		"@radix-ui/react-checkbox": "^1.4.0",
		"@radix-ui/react-dropdown-menu": "^2.2.0",
		"@radix-ui/react-separator": "^1.2.0",
		"@radix-ui/react-slot": "^1.5.0",
		"@radix-ui/react-tabs": "^1.2.0",
		"@tailwindcss/vite": "^4.3.3",
		"@tanstack/react-table": "^8.21.3",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"cors": "^2.8.6",
		"express": "^5.3.0",
		"fast-safe-stringify": "^2.1.1",
		"lucide-react": "^1.55.0",
		"pino": "^10.4.0",
		"pino-abstract-transport": "^3.0.0",
		"pino-pretty": "^13.2.0",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"swr": "^2.5.1",
		"tailwind-merge": "^3.7.0",
		"tailwindcss": "^4.3.3",
		"yaml": "2.9.1",
		"zod": "4.6.6"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/cors": "^2.8.19",
		"@types/express": "^5.0.6",
		"@types/node": "^26.6.5",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.2",
		"concurrently": "^10.0.6",
		"cross-env": "^10.1.0",
		"eslint": "^10.12.0",
		"eslint-plugin-react-hooks": "^7.1.1",
		"eslint-plugin-react-refresh": "^0.5.7",
		"globals": "^17.13.0",
		"nodemon": "^3.1.14",
		"rimraf": "^6.1.3",
		"tsx": "^4.23.15",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.71.1",
		"vite": "^8.3.4",
		"vite-plugin-singlefile": "^2.3.3",
		"vitest": "^4.1.11"
	}
}
